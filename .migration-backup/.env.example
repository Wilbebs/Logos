# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key — bypasses RLS for server-side storage uploads.
# Find in: Supabase Dashboard → Project Settings → API → service_role
# NEVER expose this in the frontend / VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── AI ────────────────────────────────────────────────────────────────────────
# Gemini — used for chatbot, acceptance letter generation, and AI eligibility review
GEMINI_API_KEY=your_gemini_api_key

# Anthropic Claude — legacy eligibility review path (optional if using Gemini)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=admissions@logos.edu

# Comma-separated list of emails that are allowed to receive real emails.
# All other recipients are blocked (logged as "blocked" in email_log).
# Add your own email here for testing.
EMAIL_ALLOWLIST=you@example.com

# ── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=your_webhook_secret_string

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Misc ──────────────────────────────────────────────────────────────────────
ADMISSIONS_EMAIL=admissions@logos.edu
FORM_2_URL=https://your-machform-url/form2
FORM_3_URL=https://your-machform-url/form3
